# Copy this file to .env.local and fill in your own values.
# These are PUBLIC values (safe in frontend code) — protected by Row Level Security.
# NEVER put the Supabase service_role key here.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → anon / public key
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base path for GitHub Pages. Use /<repo-name>/ for a project site,
# or / for a user site (<user>.github.io). Locally you can leave it as /.
VITE_BASE_PATH=/
